# API base URL (default http://localhost:4001/api/v1)
VITE_API_URL=http://localhost:4001/api/v1

# Optional: Google Maps JavaScript API key for the designer Site map (satellite imagery and address search).
# Put the real key in frontend/.env.local (not committed). Restrict it by HTTP referrer and to the APIs below in Google Cloud Console.
# Needs: Maps JavaScript API and Geocoding API. Without it the free OpenStreetMap/Esri map is used.
VITE_GOOGLE_MAPS_API_KEY=
